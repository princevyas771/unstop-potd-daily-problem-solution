import java.io.*;
import java.util.*;

public class Main {

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0) return -1;
            }
            return buffer[ptr++];
        }

        int nextInt() throws IOException {
            int c;
            while ((c = read()) <= ' ') ;
            int sign = 1;
            if (c == '-') {
                sign = -1;
                c = read();
            }
            int val = 0;
            while (c > ' ') {
                val = val * 10 + (c - '0');
                c = read();
            }
            return val * sign;
        }
    }

    static class Query {
        int l, r, idx, block;

        Query(int l, int r, int idx, int block) {
            this.l = l;
            this.r = r;
            this.idx = idx;
            this.block = block;
        }
    }

    public static void main(String[] args) throws Exception {
        FastScanner fs = new FastScanner();

        int n = fs.nextInt();
        int q = fs.nextInt();

        int[] arr = new int[n];
        for (int i = 0; i < n; i++) arr[i] = fs.nextInt();

        int blockSize = (int) Math.sqrt(n);

        Query[] queries = new Query[q];
        for (int i = 0; i < q; i++) {
            int l = fs.nextInt() - 1;
            int r = fs.nextInt() - 1;
            queries[i] = new Query(l, r, i, l / blockSize);
        }

        Arrays.sort(queries, (a, b) -> {
            if (a.block != b.block)
                return Integer.compare(a.block, b.block);
            if ((a.block & 1) == 0)
                return Integer.compare(a.r, b.r);
            else
                return Integer.compare(b.r, a.r);
        });

        int MAX = 1_000_000;
        int[] freq = new int[MAX + 1];
        long[] ans = new long[q];

        int curL = 0;
        int curR = -1;
        long current = 0;

        for (Query qu : queries) {
            while (curL > qu.l) {
                curL--;
                int x = arr[curL];
                current += 2L * freq[x] + 1;
                freq[x]++;
            }

            while (curR < qu.r) {
                curR++;
                int x = arr[curR];
                current += 2L * freq[x] + 1;
                freq[x]++;
            }

            while (curL < qu.l) {
                int x = arr[curL];
                current -= 2L * freq[x] - 1;
                freq[x]--;
                curL++;
            }

            while (curR > qu.r) {
                int x = arr[curR];
                current -= 2L * freq[x] - 1;
                freq[x]--;
                curR--;
            }

            ans[qu.idx] = current;
        }

        StringBuilder sb = new StringBuilder();
        for (long x : ans) {
            sb.append(x).append('\n');
        }
        System.out.print(sb);
    }
}
